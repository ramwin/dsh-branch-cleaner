{
  "name": "dsh-branch-cleaner",
  "version": "0.1.0",
  "description": "DeepSeek Harness 的冗余分支清理工具：找出已经落地到主线的 git 分支（普通合并 / squash 合并 / rebase 落地 / 上游已删 / PR 已合并）并可一键删除，默认只报告、删除前自动备份到 refs/backup/branch-cleaner/。Branch cleaner plugin for DSH — detect merged, squash-merged, patch-equivalent, upstream-gone and PR-merged branches, then delete them safely.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "assets/delete_redundant_branch.sh",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-web",
    "git",
    "branch",
    "branches",
    "cleanup",
    "prune",
    "stale-branches",
    "merged-branches",
    "squash-merge",
    "分支清理",
    "冗余分支",
    "已合并分支"
  ],
  "author": {
    "name": "ramwin",
    "email": "ramwin@qq.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramwin/dsh-branch-cleaner.git"
  },
  "homepage": "https://github.com/ramwin/dsh-branch-cleaner#readme",
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0"
  }
}
